# PostgreSQL 容器第一次启动时创建的数据库名称
POSTGRES_DB=ticketpilot

# PostgreSQL 容器第一次启动时创建的用户
POSTGRES_USER=ticketpilot

# 仅供本地开发使用的示例密码
# 生产环境必须替换成安全密码
POSTGRES_PASSWORD=ticketpilot-local-password

# FastAPI、SQLAlchemy 和 Alembic 使用的数据库连接地址
DATABASE_URL=postgresql+psycopg://ticketpilot:ticketpilot-local-password@127.0.0.1:5432/ticketpilot

# 如果不想运行 PostgreSQL，可以注释上面的 DATABASE_URL
# 然后启用下面的 SQLite 地址
# DATABASE_URL=sqlite:///./data/ticketpilot.db
