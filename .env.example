# PostgreSQL 容器第一次启动时创建的数据库名称
POSTGRES_DB=ticketpilot

# PostgreSQL 容器第一次启动时创建的用户
POSTGRES_USER=ticketpilot

# 仅供本地开发使用的示例密码
# 生产环境必须替换成安全密码
POSTGRES_PASSWORD=ticketpilot-local-password

# FastAPI、SQLAlchemy 和 Alembic 使用的数据库连接地址
DATABASE_URL=postgresql+psycopg://ticketpilot:ticketpilot-local-password@127.0.0.1:5432/ticketpilot

# 如果不想运行 PostgreSQL，可以注释上面的 DATABASE_URL
# 然后启用下面的 SQLite 地址
# DATABASE_URL=sqlite:///./data/ticketpilot.db
# JWT 签名密钥，生产环境必须使用随机生成的安全值
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

# JWT 登录令牌的有效分钟数
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ollama 本地服务地址
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Agent 对话使用的模型
OLLAMA_MODEL=qwen3:1.7b

# Agent 对话请求超时时间
OLLAMA_TIMEOUT_SECONDS=120

# 知识向量使用的模型
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Embedding 请求超时时间
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=120

# 每批最多生成多少段文本的向量
EMBEDDING_BATCH_SIZE=16