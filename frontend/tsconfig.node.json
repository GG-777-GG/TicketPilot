/*
 * 文件职责：配置 vite.config.ts 等 Node 环境工具文件的 TypeScript 检查。
 * 作用与配合：提供 Node 类型与模块规则，与浏览器端的 tsconfig.app.json 分开检查。
 * 使用位置：由 tsconfig.json 引用，当前检查范围为 vite.config.ts。
 * 边界：不配置 Python 后端，也不决定浏览器业务页面的行为。
 */
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
